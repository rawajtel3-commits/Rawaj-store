# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Server-side HMAC secret for signing HttpOnly auth session cookies.
# Leave unset to auto-generate a secure ephemeral key at server startup.
SESSION_SECRET="MY_SESSION_SECRET"

# WHITELABEL_KMS_KEY: Server-side AES-256-GCM encryption secret for white-label assets.
WHITELABEL_KMS_KEY="MY_WHITELABEL_KMS_KEY"

# PASSWORD_PEPPER: Server-side secret used to HMAC-pepper scrypt password/PIN hashes
# and encrypt the server credential vault with AES-256-GCM.
PASSWORD_PEPPER="MY_PASSWORD_PEPPER"

# PROMPT_KMS_KEY: Server-side envelope encryption KEK for the Master Engineering Prompt vault.
PROMPT_KMS_KEY="MY_PROMPT_KMS_KEY"

# Security Alert Email Transport (Optional - in-dashboard notifications always work without external keys):
# RESEND_API_KEY="MY_RESEND_API_KEY"
# SECURITY_ALERT_FROM_EMAIL="security@rawaj.store"
# SECURITY_ALERT_WEBHOOK_URL="https://alerts.example.com/webhook"

# Google Analytics 4 (Optional - client measurement ID e.g. G-XXXXXXXXXX):
# VITE_GA_MEASUREMENT_ID=""

# Amazon Saudi Arabia PA-API 5.0 (Optional server-side credentials; never exposed to client):
# AMAZON_SA_ACCESS_KEY=""
# AMAZON_SA_SECRET_KEY=""
# AMAZON_SA_PARTNER_TAG=""

# Custom Domain & Android App Links Verification (Optional):
# CUSTOM_DOMAIN="https://store.yourdomain.com"
# ANDROID_APP_PACKAGE="com.rawaj.store"
# ANDROID_SHA256_CERT_FINGERPRINTS="AA:BB:CC:..."
