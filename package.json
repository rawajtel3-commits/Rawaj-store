    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "firebase": "^13.3.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
